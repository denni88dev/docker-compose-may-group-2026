# Build stage
FROM node:18 AS builder

WORKDIR /usr/src/app

COPY package*.json .

RUN npm install

COPY . .

# Runtime stage

FROM node:18-slim

WORKDIR /usr/src/app

COPY --from=builder /usr/src/app .

ENV PORT=3001 \
    DB=world \
    DBUSER=kaizen \
    DBPASS=hello123 \
    DBHOST=34.170.23.1 \
    DBPORT=3306

EXPOSE 3001

CMD ["npm", "start"]

